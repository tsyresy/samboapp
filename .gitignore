# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# Env files (never commit secrets) — only the template is tracked
.env
.env.*
!.env.example

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# Signing keys and store credentials (Android keystores, EAS local
# credentials, Play Store / App Store service accounts)
*.keystore
credentials.json
credentials/
*credentials*.json
service-account*.json
google-play*.json
AuthKey_*.p8
*.pfx

# Logs
*.log
logs/

# Database dumps / backups (contain members' personal data)
*.dump
*.backup
backups/
dump*.sql

# AI / tooling local state (may hold tokens or session data)
.claude/settings.local.json
.mcp.json
.impeccable/

# Build & test artefacts
coverage/
playwright-report/
test-results/
*.apk
*.aab
*.ipa
